# Supabase (required for auth, data, storage)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Use either classic anon JWT OR new publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (optional). Enables admin UI user creation at /admin/users.
# Never expose in client code or NEXT_PUBLIC_* vars.
# Dashboard → Project Settings → API → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=

# Current academic term (defaults: 2026 / semester 1 if unset)
NEXT_PUBLIC_CURRENT_YEAR=2026
NEXT_PUBLIC_CURRENT_SEMESTER=1

# Optional — only for scripts/apply-migrations.mjs (never commit real password)
# Region for this project: ap-southeast-1 (Singapore) session pooler
# SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_PASSWORD=